---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="wrap-narrow" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1>That one went foul.</h1>
      <p class="lead">We couldn’t find that page. Let’s get you back in the game.</p>
      <p style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:2rem">
        <a class="btn btn-lg" href="/gear-guide/">Build my gear list</a>
        <a class="btn btn-lg btn-ghost" href="/guides/">Browse guides</a>
      </p>
    </div>
  </section>
</Base>
